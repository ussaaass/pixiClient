# Copy to .env locally. Never commit .env or place API keys in client-side files.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional OpenAI raster generation settings (PNG/WebP specs).
OPENAI_MAIN_MODEL=
OPENAI_IMAGE_MODEL=

# Space Bunny SVG generation settings (SVG specs).
SPACE_BUNNY_API_KEY=
SPACE_BUNNY_BASE_URL=https://spacebunny.app/api/v1
SPACE_BUNNY_MODEL=stealth/space-bunny-alpha

# Maximum bytes accepted for one generated candidate.
ASSET_MAX_OUTPUT_BYTES=15000000

# Optional SOCKS5 proxy for outbound generation API calls.
# Format: socks5://HOST:PORT (keep proxy credentials out of shell history and chat).
ASSET_SOCKS5_PROXY=
