{
  "name": "@gameing/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/cli/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@gameing/backend": "workspace:*",
    "@gameing/contracts": "workspace:*",
    "@koa/router": "15.7.0",
    "@sinclair/typebox": "0.34.52",
    "koa": "3.2.1",
    "mysql2": "3.24.6",
    "sequelize": "6.37.8",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/koa": "3.0.3",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
